generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Guest {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  maxPeople Int      @default(1)

  response  GuestResponse?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seatingAssignment SeatingAssignment?
}

model GuestResponse {
  id Int @id @default(autoincrement())

  guestId Int   @unique
  guest   Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  status       AttendanceStatus
  peopleCount  Int?
  drinks       String?
  comment      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AttendanceStatus {
  WILL_COME
  WILL_NOT_COME
}

enum SeatingTableType {
  ROUND
  PRESIDIUM
}

model SeatingTable {
  id        Int              @id @default(autoincrement())
  name      String
  type      SeatingTableType @default(ROUND)
  seats     Int              @default(8)
  positionX Int @default(500)
  positionY Int @default(500)

  assignments SeatingAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeatingAssignment {
  id Int @id @default(autoincrement())

  tableId Int
  table   SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  guestId Int @unique
  guest   Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  peopleCount Int @default(1)
  seatStart   Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}